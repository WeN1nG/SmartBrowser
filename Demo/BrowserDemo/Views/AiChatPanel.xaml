<UserControl x:Class="BrowserDemo.Views.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BrowserDemo"
             xmlns:conv="clr-namespace:BrowserDemo.MarkdownConverters"
             mc:Ignorable="d"
             d:DesignWidth="360"
             Background="#1A1A1E">

    <UserControl.Resources>
        <local:MessageRoleBgConverter x:Key="RoleBgConv"/>
        <local:MessageRoleBorderConverter x:Key="RoleBorderConv"/>
        <conv:MarkdownToFlowDocumentConverter x:Key="MdConv"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 标题栏 ====== -->
        <Border Grid.Row="0" Background="#252529" Padding="10,8" BorderBrush="#3A3A3E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="AI 助手" Foreground="#EEE"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <!-- Token 计数 -->
                <TextBlock Grid.Column="1" Text="{Binding TokenEstimate, StringFormat='~{0} tokens'}"
                           Foreground="#666" FontSize="10" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>

                <!-- 新建对话 -->
                <Button Grid.Column="2" Content="＋" Width="28" Height="24"
                        Command="{Binding NewConversationCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#AAA" FontSize="16"
                        Cursor="Hand" ToolTip="新建对话"/>

                <!-- 设置 -->
                <Button Grid.Column="3" Content="⚙" Width="28" Height="24"
                        Command="{Binding OpenSettingsCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#AAA" FontSize="15"
                        Cursor="Hand" ToolTip="AI 设置"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="260" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ====== 对话列表（最近对话） ====== -->
                <Border Grid.Row="0" Background="#1E1E22" Padding="6,4"
                        BorderBrush="#3A3A3E" BorderThickness="0,0,0,1"
                        Height="Auto" MaxHeight="100">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="最近对话" Foreground="#666"
                                   FontSize="10" Margin="4,0,0,2"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="70">
                            <ItemsControl ItemsSource="{Binding ConversationList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0" Margin="0,1" CornerRadius="3"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 点击加载聊天记录 -->
                                                <Button Grid.Column="0"
                                                        Command="{Binding DataContext.LoadConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="6,3">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="{Binding Preview}"
                                                                           Foreground="#BBB" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="1" Content="✕" Width="16" Height="16"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#666" FontSize="8"
                                                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"
                                                        Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ====== 消息列表 ====== -->
                <ScrollViewer x:Name="MessageScroller" Grid.Row="1"
                              Background="Transparent"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,8,8,0"
                              PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Background="#22222A"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        BorderBrush="{Binding Role, Converter={StaticResource RoleBorderConv}}"
                                        BorderThickness="1,1,1,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 头部：角色 + 时间 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{Binding Role, Converter={StaticResource RoleBgConv}}"
                                                    CornerRadius="3" Padding="5,1,5,2">
                                                <TextBlock Text="{Binding RoleLabel}"
                                                           Foreground="White" FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                       Foreground="#555" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 消息内容（Markdown 渲染） -->
                                        <FlowDocumentScrollViewer Grid.Row="1"
                                            Document="{Binding Content, Converter={StaticResource MdConv}}"
                                            Background="Transparent"
                                            IsTabStop="False"
                                            VerticalScrollBarVisibility="Hidden"
                                            HorizontalScrollBarVisibility="Disabled"
                                            Padding="0"
                                            MaxHeight="600"
                                            FontFamily="Segoe UI"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ====== 实时 Todo 列表 ====== -->
            <Border Grid.Column="1" Background="#202026" Padding="10,8"
                    BorderBrush="#3A3A3E" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="实时任务清单" Foreground="#AAA"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TodoItems}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TodoItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="8,7" CornerRadius="6"
                                            Background="#282832" BorderBrush="#3A3A45" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <Border DockPanel.Dock="Left" Background="#30303A" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#DDD" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="{Binding Id}" Foreground="#666" FontSize="10" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#EEE" FontSize="12"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Notes}" Foreground="#888" FontSize="10"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== AI 提问卡片（ask_user 暂停时显示） ====== -->
        <Border Grid.Row="2" Background="#2A2A35" Padding="12,10" Margin="8,0,8,6"
                CornerRadius="8" BorderBrush="#0078D4" BorderThickness="1,0,0,0"
                x:Name="QuestionCard">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAwaitingUserInput}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="🤔 AI 需要你的指引"
                           Foreground="#EEE" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <!-- 上下文摘要 -->
                <TextBlock Text="{Binding PendingAskUserQuestion.ContextSummary}"
                           Foreground="#AAA" FontSize="10" TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <!-- 问题文本 -->
                <TextBlock Text="{Binding PendingAskUserQuestion.Question}"
                           Foreground="#FFF" FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- 选项按钮（multiple_choice / confirmation） -->
                <ItemsControl ItemsSource="{Binding PendingAskUserQuestion.Options}"
                              Margin="0,0,0,6">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingAskUserQuestion.QuestionType}" Value="multiple_choice">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Background="#3A3A45" BorderBrush="#50505A"
                                    BorderThickness="1" Margin="0,2">
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.RespondToQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#EEE"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="8,4" FontSize="11"
                                        HorizontalAlignment="Stretch"
                                        Cursor="Hand"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 确认按钮（confirmation 模式） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingAskUserQuestion.QuestionType}" Value="confirmation">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border CornerRadius="4" Background="#4A2030" Margin="0,0,6,0">
                        <Button Content="否 / 取消"
                                Command="{Binding RespondToQuestionCommand}" CommandParameter="no"
                                Foreground="#EEE"
                                Background="Transparent" BorderThickness="0"
                                Padding="10,4" FontSize="11" Cursor="Hand"/>
                    </Border>
                    <Border CornerRadius="4" Background="#0078D4">
                        <Button Content="是 / 确认"
                                Command="{Binding RespondToQuestionCommand}" CommandParameter="yes"
                                Foreground="White"
                                Background="Transparent" BorderThickness="0"
                                Padding="10,4" FontSize="11" Cursor="Hand"/>
                    </Border>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="跳过 (让 AI 自己决定)"
                            Command="{Binding SkipQuestionCommand}"
                            Background="Transparent" Foreground="#888"
                            BorderThickness="0" Padding="4,2"
                            FontSize="10" Margin="0,0,8,0"
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ====== 底部输入区 ====== -->
        <Border Grid.Row="3" Background="#252529" Padding="8,8,8,10"
                BorderBrush="#3A3A3E" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 状态提示 -->
                <TextBlock Grid.Row="0" Text="{Binding StatusMessage}"
                           Foreground="#888" FontSize="10"
                           Margin="4,0,0,4"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 输入框 -->
                    <Border Grid.Column="0" Background="#1A1A1E" CornerRadius="6"
                            BorderBrush="#3A3A3E" BorderThickness="1"
                            Height="36" Margin="0,0,6,0">
                        <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#EEE" FontSize="12"
                                 Padding="10,0,10,0" VerticalAlignment="Center"
                                 FontFamily="Segoe UI"
                                 CaretBrush="White"
                                 AcceptsReturn="False"
                                 x:Name="InputBox"
                                 KeyDown="InputBox_KeyDown"/>
                    </Border>

                    <!-- 发送按钮 -->
                    <Button Grid.Column="1" Content="发送" Width="56" Height="36"
                            Command="{Binding SendCommand}"
                            Background="#0078D4" BorderThickness="0"
                            Foreground="White" FontSize="12"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BgBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="0">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="BgBorder" Property="Background" Value="#555"/>
                                                    <Setter Property="Foreground" Value="#999"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
