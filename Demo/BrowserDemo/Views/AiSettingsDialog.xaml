<Window x:Class="BrowserDemo.Views.AiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI 设置 — 服务商 &amp; 模型"
        Height="560" Width="560"
        MinHeight="560" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E22"
        Foreground="#EEE"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InputBase" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#000"/>
            <Setter Property="BorderBrush" Value="#4A4A4E"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#000"/>
                        <Setter Property="Background" Value="#FFF"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="BorderBrush" Value="#4A4A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style TargetType="PasswordBox" x:Key="FieldPassword">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="BorderBrush" Value="#4A4A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="AI 服务配置" FontSize="16"
                   FontWeight="SemiBold" Foreground="#EEE"
                   Margin="0,0,0,12"/>

        <!-- 表单滚动 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>

                <!-- ===== 1. 模型名称 ===== -->
                <Label Style="{StaticResource FieldLabel}" Content="模型名称"/>
                <TextBox x:Name="DisplayNameBox" Style="{StaticResource TextBoxStyle}"/>

                <!-- ===== 2. 服务商选择 ===== -->
                <Label Style="{StaticResource FieldLabel}" Content="AI 服务商"/>
                <ComboBox x:Name="ProviderCombo"
                          Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="ProviderCombo_SelectionChanged"/>

                <!-- 服务商标识 + 认证方式提示 -->
                <Border Background="#2A2A2E" CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#3A3A3E" CornerRadius="3" Padding="5,1">
                            <TextBlock x:Name="ProviderBadge" Text="官方"
                                       Foreground="#4FC3F7" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="AuthTypeText" Text="Bearer Token"
                                   Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" x:Name="EndpointPreview" Text="https://..."
                                   Foreground="#666" FontSize="10" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- ===== 2. API Key ===== -->
                <Label Style="{StaticResource FieldLabel}" Content="API Key"/>
                <PasswordBox x:Name="ApiKeyBox"
                             Style="{StaticResource FieldPassword}"/>

                <!-- ===== 3. 模型选择 ===== -->
                <Label Style="{StaticResource FieldLabel}" Content="模型"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ModelCombo" Grid.Column="0"
                              Style="{StaticResource ComboStyle}"
                              DisplayMemberPath="Summary"
                              IsEditable="True"
                              SelectionChanged="ModelCombo_SelectionChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <!-- 手动输入模型名的提示 -->
                    <TextBlock Grid.Column="1" Text="可手动输入"
                               Foreground="#666" FontSize="10"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>

                <!-- ===== 4. 自定义端点 ===== -->
                <Label Style="{StaticResource FieldLabel}" Content="API 端点（留空 = 默认）"/>
                <TextBox x:Name="EndpointBox" Style="{StaticResource TextBoxStyle}"/>

                <TextBlock Text="修改端点可用于代理/镜像/自托管场景；火山方舟 Coding Plan OpenAI Base URL：https://ark.cn-beijing.volces.com/api/coding/v3"
                           Foreground="#666" FontSize="10" Margin="0,-6,0,10"
                           TextWrapping="Wrap"/>

                <!-- ===== 5. 测试连接 ===== -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TestBtn" Grid.Column="0" Content="🔄 测试连接"
                            Click="TestConnection_Click"
                            Background="#3A3A3E" BorderThickness="0"
                            Foreground="#DDD" FontSize="12"
                            Height="34" Cursor="Hand" Padding="12,0"/>
                    <TextBlock Grid.Column="1" x:Name="TestResultText"
                               Foreground="#888" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部按钮 ===== -->
        <Border Grid.Row="2" BorderBrush="#3A3A3E" BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="SavedIndicator"
                           Text="" Foreground="#4CAF50" FontSize="11"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="取消" Width="80" Height="32"
                        Click="Cancel_Click"
                        Background="#3A3A3E" BorderThickness="0"
                        Foreground="#DDD" FontSize="12"
                        Margin="0,0,8,0" Cursor="Hand"/>

                <Button Grid.Column="2" Content="保存" Width="80" Height="32"
                        Click="Save_Click"
                        Background="#0078D4" BorderThickness="0"
                        Foreground="White" FontSize="12"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
